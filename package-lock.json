{
  "name": "activity-island-platform",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "activity-island-platform",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "apps/desktop": {
      "name": "@activity-island/desktop",
      "version": "0.1.0",
      "dependencies": {
        "@activity-island/platform-contracts": "0.1.0"
      }
    },
    "node_modules/@activity-island/desktop": {
      "resolved": "apps/desktop",
      "link": true
    },
    "node_modules/@activity-island/platform-contracts": {
      "resolved": "packages/platform-contracts",
      "link": true
    },
    "packages/platform-contracts": {
      "name": "@activity-island/platform-contracts",
      "version": "0.1.0"
    }
  }
}
